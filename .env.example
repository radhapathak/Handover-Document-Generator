# Copy to .env.local for local development. NEVER commit real values.
# In Vercel: Project → Settings → Environment Variables.

# --- Required -----------------------------------------------------------------
# Random string (32+ chars) used to sign session cookies:  openssl rand -base64 48
AUTH_SECRET=

# Groq AI (see GROQ_SETUP.md)
GROQ_API_KEY=
# Any chat model currently listed at https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile

# --- ServiceNow (primary database; see SERVICE_NOW_SETUP.md) --------------------
SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
# Integration user for server-to-server calls (OAuth password grant).
# Leave both empty to use the client_credentials grant instead.
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=
# Your scoped app's table prefix, e.g. x_acme_hai on a real instance
SERVICENOW_TABLE_PREFIX=x_hai

# --- Demo mode (only when SERVICENOW_INSTANCE_URL is empty) -----------------------
# Explicitly labelled sample data held in server memory. Not persistent.
DEMO_MODE=false
DEMO_PASSWORD=

# --- Optional -----------------------------------------------------------------
# AI requests per user per minute (per server instance)
AI_RATE_LIMIT_PER_MINUTE=10
# Maximum reference upload size in MB
MAX_UPLOAD_MB=5
# Review allowance (hours) used in "estimated hours saved"
REVIEW_EFFORT_HOURS=1
# Legacy v1 endpoint /api/generate (ServiceNow Script Include). Leave empty to disable.
KT_SHARED_SECRET=
